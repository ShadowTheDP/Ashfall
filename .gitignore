# Godot import cache
.godot/

# Local engine binaries used for headless validation
.tools/

# Build and capture output (keep the Godot ignore marker trackable)
output/*
!output/.gdignore
*.tmp
*.log

# Session exports (pi writes these into the project root)
pi-session-*.html

# Python validation bytecode
__pycache__/

# Vendored dependencies (restore with `npm ci` inside .pi/npm)
node_modules/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
