; Engine configuration file.
; Ashfall — an original Dead-Cells-like combat study.
; Rendered at 640x360 and upscaled with integer scaling for true pixel art.

config_version=5

[application]

config/name="Ashfall (DC-like)"
config/description="Original roguelite combat-feel prototype. No third-party game code or assets."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/autoload/data.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Combat="*res://scripts/autoload/combat.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.051, 1)
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
