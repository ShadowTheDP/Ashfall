[internationalization]

locale/fallback="en"
locale/include_text_server_data=true
locale/translations=PackedStringArray("res://data/localization/ui.en.translation", "res://data/localization/ui.zh_TW.translation")

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
